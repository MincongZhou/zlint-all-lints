# 编译产物
/zlint-all-lints
/extract-cert
__pycache__/
*.pyc

# 运行产物（单证书输出）
/lint_results.json
/lint_results.csv
/cert_info.json

# 批量运行输出目录（results 开头一律忽略，含 results_1 / results_new 等）
/results*/
/result_baidu_crl/
/result_baidu_ocsp/
/extracted/

# 单证书 CRL/OCSP 下载与解析产物
/crl.pem
/resp.der
/crl_sourcedata/

# run_cert_crl_ocsp.py 的 CRL 去重缓存（下载产物，不入库）
_crl_cache/

# 证书样例目录
/certs/

# 本地签发者证书库（OCSP 构造 CertID 用，本地收集，不入库）
/issuers/

# 编辑器 / IDE
.vscode/

# 根目录 CSV 运行产物（extract_cert_fields 各模式输出 / 批量 OCSP 查询）
/all.csv
/all_extensions.csv
/*_fields.csv
/oscp_all.csv

# CFCA 批量查询脚本输出（query_cfca_certs*.sh -> cfca_cert_info*.txt）
/cfca_cert_info*.txt

# 临时调试脚本 / 临时产物（仅根目录；/tmp* /temp* 已覆盖原 /temp.sh）
/tmp*
/temp*
/out*.txt
/out*.log

# CT 日志草稿工作区（ct_log/ 目录 + crt.sh 查询脚本）
/ct_log_draft/

# 根目录批量提取产物（extract_cert_fields 对 certs/<目录> 的宽表输出）
/CFCA_Identity*.csv

# CFCA CPS文档
/CFCA

# 跑批日志（根目录的 run.log / <数据集>_ct_log.log 等，都是几 MB 的运行输出）
*.log

# 工具数据目录（CodeBuddy 工作记忆等，不入库）
/.codebuddy/
